def rd_h123 : Nat → Nat → R (Array OperationResult)
  | 0, _ => fuelOut | _, 0 => depthExceeded
  | fu + 1, d + 1 => do
    let n ← rdU32 fu d
    if n.toNat > 4294967295 then lengthExceedsMax else rdl_h123 fu d n.toNat #[]
def rdl_h123 : Nat → Nat → Nat → Array OperationResult → R (Array OperationResult)
  | 0, _, _, _ => fuelOut
  | _ + 1, _, 0, acc => pure acc
  | fu + 1, d, n + 1, acc => do let e ← rd_OperationResult fu d; rdl_h123 fu d n (acc.push e)
def wr_h123 : Nat → Nat → (Array OperationResult) → W
  | 0, _, _ => wFuelOut | _, 0, _ => wDepthExceeded
  | fu + 1, d + 1, x => if x.size > 4294967295 then wLengthExceedsMax else wSeq [wrU32 fu d x.size.toUInt32, wrl_h123 fu d x.toList]
def wrl_h123 : Nat → Nat → List OperationResult → W
  | 0, _, _ => wFuelOut
  | _ + 1, _, [] => wNil
  | fu + 1, d, e :: es => wSeq [wr_OperationResult fu d e, wrl_h123 fu d es]
def rd_h124 : Nat → Nat → R (Array OperationResult)
  | 0, _ => fuelOut | _, 0 => depthExceeded
  | fu + 1, d + 1 => do
    let n ← rdU32 fu d
