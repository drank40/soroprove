def rdl_h124 : Nat → Nat → Nat → Array OperationResult → R (Array OperationResult)
  | 0, _, _, _ => fuelOut
  | _ + 1, _, 0, acc => pure acc
  | fu + 1, d, n + 1, acc => do let e ← rd_OperationResult fu d; rdl_h124 fu d n (acc.push e)
