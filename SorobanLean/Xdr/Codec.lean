namespace Ord
def lexBytes (a b : ByteArray) : Ordering := compare a.toList b.toList
def lexArr {α} (c : α → α → Ordering) : List α → List α → Ordering
  | [], [] => .eq | [], _ => .lt | _, [] => .gt
  | x :: xs, y :: ys => match c x y with | .eq => lexArr c xs ys | o => o
def thenCmp (a : Ordering) (b : Unit → Ordering) : Ordering := match a with | .eq => b () | o => o
def cmp_Value (a b : Value) : Ordering := (lexBytes a b)
def cmp_uint32 (a b : uint32) : Ordering := (compare a.toNat b.toNat)
def cmp_SCPBallot (a b : SCPBallot) : Ordering := (thenCmp (cmp_uint32 a.counter b.counter) fun _ => (thenCmp (cmp_Value a.value b.value) fun _ => (.eq : Ordering)))
def cmp_SCPStatementType (a b : SCPStatementType) : Ordering := compare a.toI32.toInt b.toI32.toInt
def cmp_Hash (a b : Hash) : Ordering := (lexBytes a b)
def cmp_SCPNomination (a b : SCPNomination) : Ordering := (thenCmp (cmp_Hash a.quorumSetHash b.quorumSetHash) fun _ => (thenCmp (lexArr (fun x y => (cmp_Value x y)) a.votes.toList b.votes.toList) fun _ => (thenCmp (lexArr (fun x y => (cmp_Value x y)) a.accepted.toList b.accepted.toList) fun _ => (.eq : Ordering))))
def cmp_SCPStatementPrepare (a b : SCPStatementPrepare) : Ordering := (thenCmp (cmp_Hash a.quorumSetHash b.quorumSetHash) fun _ => (thenCmp (cmp_SCPBallot a.ballot b.ballot) fun _ => (thenCmp (match a.prepared, b.prepared with | none, none => .eq | none, some _ => .lt | some _, none => .gt | some x, some y => (cmp_SCPBallot x y)) fun _ => (thenCmp (match a.preparedPrime, b.preparedPrime with | none, none => .eq | none, some _ => .lt | some _, none => .gt | some x, some y => (cmp_SCPBallot x y)) fun _ => (thenCmp (cmp_uint32 a.nC b.nC) fun _ => (thenCmp (cmp_uint32 a.nH b.nH) fun _ => (.eq : Ordering)))))))
def cmp_SCPStatementConfirm (a b : SCPStatementConfirm) : Ordering := (thenCmp (cmp_SCPBallot a.ballot b.ballot) fun _ => (thenCmp (cmp_uint32 a.nPrepared b.nPrepared) fun _ => (thenCmp (cmp_uint32 a.nCommit b.nCommit) fun _ => (thenCmp (cmp_uint32 a.nH b.nH) fun _ => (thenCmp (cmp_Hash a.quorumSetHash b.quorumSetHash) fun _ => (.eq : Ordering))))))
def cmp_SCPStatementExternalize (a b : SCPStatementExternalize) : Ordering := (thenCmp (cmp_SCPBallot a.commit b.commit) fun _ => (thenCmp (cmp_uint32 a.nH b.nH) fun _ => (thenCmp (cmp_Hash a.commitQuorumSetHash b.commitQuorumSetHash) fun _ => (.eq : Ordering))))
def idx_SCPStatementPledges : SCPStatementPledges → Nat
  | .SCP_ST_PREPARE _ => 0
  | .SCP_ST_CONFIRM _ => 1
  | .SCP_ST_EXTERNALIZE _ => 2
  | .SCP_ST_NOMINATE _ => 3
def cmp_SCPStatementPledges (a b : SCPStatementPledges) : Ordering :=
  match a, b with
  | .SCP_ST_PREPARE x, .SCP_ST_PREPARE y => (cmp_SCPStatementPrepare x y)
  | .SCP_ST_CONFIRM x, .SCP_ST_CONFIRM y => (cmp_SCPStatementConfirm x y)
  | .SCP_ST_EXTERNALIZE x, .SCP_ST_EXTERNALIZE y => (cmp_SCPStatementExternalize x y)
  | .SCP_ST_NOMINATE x, .SCP_ST_NOMINATE y => (cmp_SCPNomination x y)
  | x, y => compare (idx_SCPStatementPledges x) (idx_SCPStatementPledges y)
def cmp_PublicKeyType (a b : PublicKeyType) : Ordering := compare a.toI32.toInt b.toI32.toInt
def cmp_uint256 (a b : uint256) : Ordering := (lexBytes a b)
def idx_PublicKey : PublicKey → Nat
  | .PUBLIC_KEY_TYPE_ED25519 _ => 0
def cmp_PublicKey (a b : PublicKey) : Ordering :=
  match a, b with
  | .PUBLIC_KEY_TYPE_ED25519 x, .PUBLIC_KEY_TYPE_ED25519 y => (cmp_uint256 x y)
def cmp_NodeID (a b : NodeID) : Ordering := (cmp_PublicKey a b)
def cmp_uint64 (a b : uint64) : Ordering := (compare a.toNat b.toNat)
def cmp_SCPStatement (a b : SCPStatement) : Ordering := (thenCmp (cmp_NodeID a.nodeID b.nodeID) fun _ => (thenCmp (cmp_uint64 a.slotIndex b.slotIndex) fun _ => (thenCmp (cmp_SCPStatementPledges a.pledges b.pledges) fun _ => (.eq : Ordering))))
def cmp_Signature (a b : Signature) : Ordering := (lexBytes a b)
def cmp_SCPEnvelope (a b : SCPEnvelope) : Ordering := (thenCmp (cmp_SCPStatement a.statement b.statement) fun _ => (thenCmp (cmp_Signature a.signature b.signature) fun _ => (.eq : Ordering)))
def cmp_EncodedLedgerKey (a b : EncodedLedgerKey) : Ordering := (lexBytes a b)
def cmp_ConfigSettingContractExecutionLanesV0 (a b : ConfigSettingContractExecutionLanesV0) : Ordering := (thenCmp (cmp_uint32 a.ledgerMaxTxCount b.ledgerMaxTxCount) fun _ => (.eq : Ordering))
def cmp_int64 (a b : int64) : Ordering := (compare a.toInt b.toInt)
def cmp_ConfigSettingContractComputeV0 (a b : ConfigSettingContractComputeV0) : Ordering := (thenCmp (cmp_int64 a.ledgerMaxInstructions b.ledgerMaxInstructions) fun _ => (thenCmp (cmp_int64 a.txMaxInstructions b.txMaxInstructions) fun _ => (thenCmp (cmp_int64 a.feeRatePerInstructionsIncrement b.feeRatePerInstructionsIncrement) fun _ => (thenCmp (cmp_uint32 a.txMemoryLimit b.txMemoryLimit) fun _ => (.eq : Ordering)))))
def cmp_ConfigSettingContractParallelComputeV0 (a b : ConfigSettingContractParallelComputeV0) : Ordering := (thenCmp (cmp_uint32 a.ledgerMaxDependentTxClusters b.ledgerMaxDependentTxClusters) fun _ => (.eq : Ordering))
def cmp_ConfigSettingContractLedgerCostV0 (a b : ConfigSettingContractLedgerCostV0) : Ordering := (thenCmp (cmp_uint32 a.ledgerMaxDiskReadEntries b.ledgerMaxDiskReadEntries) fun _ => (thenCmp (cmp_uint32 a.ledgerMaxDiskReadBytes b.ledgerMaxDiskReadBytes) fun _ => (thenCmp (cmp_uint32 a.ledgerMaxWriteLedgerEntries b.ledgerMaxWriteLedgerEntries) fun _ => (thenCmp (cmp_uint32 a.ledgerMaxWriteBytes b.ledgerMaxWriteBytes) fun _ => (thenCmp (cmp_uint32 a.txMaxDiskReadEntries b.txMaxDiskReadEntries) fun _ => (thenCmp (cmp_uint32 a.txMaxDiskReadBytes b.txMaxDiskReadBytes) fun _ => (thenCmp (cmp_uint32 a.txMaxWriteLedgerEntries b.txMaxWriteLedgerEntries) fun _ => (thenCmp (cmp_uint32 a.txMaxWriteBytes b.txMaxWriteBytes) fun _ => (thenCmp (cmp_int64 a.feeDiskReadLedgerEntry b.feeDiskReadLedgerEntry) fun _ => (thenCmp (cmp_int64 a.feeWriteLedgerEntry b.feeWriteLedgerEntry) fun _ => (thenCmp (cmp_int64 a.feeDiskRead1KB b.feeDiskRead1KB) fun _ => (thenCmp (cmp_int64 a.sorobanStateTargetSizeBytes b.sorobanStateTargetSizeBytes) fun _ => (thenCmp (cmp_int64 a.rentFee1KBSorobanStateSizeLow b.rentFee1KBSorobanStateSizeLow) fun _ => (thenCmp (cmp_int64 a.rentFee1KBSorobanStateSizeHigh b.rentFee1KBSorobanStateSizeHigh) fun _ => (thenCmp (cmp_uint32 a.sorobanStateRentFeeGrowthFactor b.sorobanStateRentFeeGrowthFactor) fun _ => (.eq : Ordering))))))))))))))))
def cmp_ConfigSettingContractLedgerCostExtV0 (a b : ConfigSettingContractLedgerCostExtV0) : Ordering := (thenCmp (cmp_uint32 a.txMaxFootprintEntries b.txMaxFootprintEntries) fun _ => (thenCmp (cmp_int64 a.feeWrite1KB b.feeWrite1KB) fun _ => (.eq : Ordering)))
def cmp_ConfigSettingContractHistoricalDataV0 (a b : ConfigSettingContractHistoricalDataV0) : Ordering := (thenCmp (cmp_int64 a.feeHistorical1KB b.feeHistorical1KB) fun _ => (.eq : Ordering))
def cmp_ConfigSettingContractEventsV0 (a b : ConfigSettingContractEventsV0) : Ordering := (thenCmp (cmp_uint32 a.txMaxContractEventsSizeBytes b.txMaxContractEventsSizeBytes) fun _ => (thenCmp (cmp_int64 a.feeContractEvents1KB b.feeContractEvents1KB) fun _ => (.eq : Ordering)))
def cmp_ConfigSettingContractBandwidthV0 (a b : ConfigSettingContractBandwidthV0) : Ordering := (thenCmp (cmp_uint32 a.ledgerMaxTxsSizeBytes b.ledgerMaxTxsSizeBytes) fun _ => (thenCmp (cmp_uint32 a.txMaxSizeBytes b.txMaxSizeBytes) fun _ => (thenCmp (cmp_int64 a.feeTxSize1KB b.feeTxSize1KB) fun _ => (.eq : Ordering))))
def cmp_ContractCostType (a b : ContractCostType) : Ordering := compare a.toI32.toInt b.toI32.toInt
def idx_ExtensionPoint : ExtensionPoint → Nat
  | .v0 => 0
def cmp_ExtensionPoint (a b : ExtensionPoint) : Ordering :=
  match a, b with
  | .v0, .v0 => .eq
def cmp_ContractCostParamEntry (a b : ContractCostParamEntry) : Ordering := (thenCmp (cmp_ExtensionPoint a.ext b.ext) fun _ => (thenCmp (cmp_int64 a.constTerm b.constTerm) fun _ => (thenCmp (cmp_int64 a.linearTerm b.linearTerm) fun _ => (.eq : Ordering))))
