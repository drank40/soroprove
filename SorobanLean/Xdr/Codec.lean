  | 0, _, _ => wFuelOut | _, 0, _ => wDepthExceeded
  | fu + 1, d + 1, x => if x.size > 4294967295 then wLengthExceedsMax else wSeq [wrU32 fu d x.size.toUInt32, wrl_h115 fu d x.toList]
