def rd_OperationBody : Nat → Nat → R OperationBody
  | 0, _ => fuelOut | _, 0 => depthExceeded
  | fu + 1, d + 1 => do
    let disc ← rd_OperationType fu d
    match disc with
    | .CREATE_ACCOUNT => do let a ← rd_CreateAccountOp fu d; pure (.CREATE_ACCOUNT a)
    | .PAYMENT => do let a ← rd_PaymentOp fu d; pure (.PAYMENT a)
    | .PATH_PAYMENT_STRICT_RECEIVE => do let a ← rd_PathPaymentStrictReceiveOp fu d; pure (.PATH_PAYMENT_STRICT_RECEIVE a)
    | .MANAGE_SELL_OFFER => do let a ← rd_ManageSellOfferOp fu d; pure (.MANAGE_SELL_OFFER a)
    | .CREATE_PASSIVE_SELL_OFFER => do let a ← rd_CreatePassiveSellOfferOp fu d; pure (.CREATE_PASSIVE_SELL_OFFER a)
    | .SET_OPTIONS => do let a ← rd_SetOptionsOp fu d; pure (.SET_OPTIONS a)
    | .CHANGE_TRUST => do let a ← rd_ChangeTrustOp fu d; pure (.CHANGE_TRUST a)
    | .ALLOW_TRUST => do let a ← rd_AllowTrustOp fu d; pure (.ALLOW_TRUST a)
    | .ACCOUNT_MERGE => do let a ← rd_MuxedAccount fu d; pure (.ACCOUNT_MERGE a)
    | .INFLATION => pure .INFLATION
    | .MANAGE_DATA => do let a ← rd_ManageDataOp fu d; pure (.MANAGE_DATA a)
    | .BUMP_SEQUENCE => do let a ← rd_BumpSequenceOp fu d; pure (.BUMP_SEQUENCE a)
    | .MANAGE_BUY_OFFER => do let a ← rd_ManageBuyOfferOp fu d; pure (.MANAGE_BUY_OFFER a)
    | .PATH_PAYMENT_STRICT_SEND => do let a ← rd_PathPaymentStrictSendOp fu d; pure (.PATH_PAYMENT_STRICT_SEND a)
    | .CREATE_CLAIMABLE_BALANCE => do let a ← rd_CreateClaimableBalanceOp fu d; pure (.CREATE_CLAIMABLE_BALANCE a)
    | .CLAIM_CLAIMABLE_BALANCE => do let a ← rd_ClaimClaimableBalanceOp fu d; pure (.CLAIM_CLAIMABLE_BALANCE a)
    | .BEGIN_SPONSORING_FUTURE_RESERVES => do let a ← rd_BeginSponsoringFutureReservesOp fu d; pure (.BEGIN_SPONSORING_FUTURE_RESERVES a)
    | .END_SPONSORING_FUTURE_RESERVES => pure .END_SPONSORING_FUTURE_RESERVES
    | .REVOKE_SPONSORSHIP => do let a ← rd_RevokeSponsorshipOp fu d; pure (.REVOKE_SPONSORSHIP a)
    | .CLAWBACK => do let a ← rd_ClawbackOp fu d; pure (.CLAWBACK a)
    | .CLAWBACK_CLAIMABLE_BALANCE => do let a ← rd_ClawbackClaimableBalanceOp fu d; pure (.CLAWBACK_CLAIMABLE_BALANCE a)
    | .SET_TRUST_LINE_FLAGS => do let a ← rd_SetTrustLineFlagsOp fu d; pure (.SET_TRUST_LINE_FLAGS a)
    | .LIQUIDITY_POOL_DEPOSIT => do let a ← rd_LiquidityPoolDepositOp fu d; pure (.LIQUIDITY_POOL_DEPOSIT a)
    | .LIQUIDITY_POOL_WITHDRAW => do let a ← rd_LiquidityPoolWithdrawOp fu d; pure (.LIQUIDITY_POOL_WITHDRAW a)
    | .INVOKE_HOST_FUNCTION => do let a ← rd_InvokeHostFunctionOp fu d; pure (.INVOKE_HOST_FUNCTION a)
    | .EXTEND_FOOTPRINT_TTL => do let a ← rd_ExtendFootprintTTLOp fu d; pure (.EXTEND_FOOTPRINT_TTL a)
    | .RESTORE_FOOTPRINT => do let a ← rd_RestoreFootprintOp fu d; pure (.RESTORE_FOOTPRINT a)
def wr_OperationBody : Nat → Nat → OperationBody → W
  | 0, _, _ => wFuelOut | _, 0, _ => wDepthExceeded
  | fu + 1, d + 1, .CREATE_ACCOUNT a => wSeq [wr_OperationType fu d .CREATE_ACCOUNT, wr_CreateAccountOp fu d a]
  | fu + 1, d + 1, .PAYMENT a => wSeq [wr_OperationType fu d .PAYMENT, wr_PaymentOp fu d a]
  | fu + 1, d + 1, .PATH_PAYMENT_STRICT_RECEIVE a => wSeq [wr_OperationType fu d .PATH_PAYMENT_STRICT_RECEIVE, wr_PathPaymentStrictReceiveOp fu d a]
  | fu + 1, d + 1, .MANAGE_SELL_OFFER a => wSeq [wr_OperationType fu d .MANAGE_SELL_OFFER, wr_ManageSellOfferOp fu d a]
  | fu + 1, d + 1, .CREATE_PASSIVE_SELL_OFFER a => wSeq [wr_OperationType fu d .CREATE_PASSIVE_SELL_OFFER, wr_CreatePassiveSellOfferOp fu d a]
  | fu + 1, d + 1, .SET_OPTIONS a => wSeq [wr_OperationType fu d .SET_OPTIONS, wr_SetOptionsOp fu d a]
  | fu + 1, d + 1, .CHANGE_TRUST a => wSeq [wr_OperationType fu d .CHANGE_TRUST, wr_ChangeTrustOp fu d a]
  | fu + 1, d + 1, .ALLOW_TRUST a => wSeq [wr_OperationType fu d .ALLOW_TRUST, wr_AllowTrustOp fu d a]
  | fu + 1, d + 1, .ACCOUNT_MERGE a => wSeq [wr_OperationType fu d .ACCOUNT_MERGE, wr_MuxedAccount fu d a]
  | fu + 1, d + 1, .INFLATION => wr_OperationType fu d .INFLATION
  | fu + 1, d + 1, .MANAGE_DATA a => wSeq [wr_OperationType fu d .MANAGE_DATA, wr_ManageDataOp fu d a]
  | fu + 1, d + 1, .BUMP_SEQUENCE a => wSeq [wr_OperationType fu d .BUMP_SEQUENCE, wr_BumpSequenceOp fu d a]
  | fu + 1, d + 1, .MANAGE_BUY_OFFER a => wSeq [wr_OperationType fu d .MANAGE_BUY_OFFER, wr_ManageBuyOfferOp fu d a]
  | fu + 1, d + 1, .PATH_PAYMENT_STRICT_SEND a => wSeq [wr_OperationType fu d .PATH_PAYMENT_STRICT_SEND, wr_PathPaymentStrictSendOp fu d a]
  | fu + 1, d + 1, .CREATE_CLAIMABLE_BALANCE a => wSeq [wr_OperationType fu d .CREATE_CLAIMABLE_BALANCE, wr_CreateClaimableBalanceOp fu d a]
  | fu + 1, d + 1, .CLAIM_CLAIMABLE_BALANCE a => wSeq [wr_OperationType fu d .CLAIM_CLAIMABLE_BALANCE, wr_ClaimClaimableBalanceOp fu d a]
  | fu + 1, d + 1, .BEGIN_SPONSORING_FUTURE_RESERVES a => wSeq [wr_OperationType fu d .BEGIN_SPONSORING_FUTURE_RESERVES, wr_BeginSponsoringFutureReservesOp fu d a]
  | fu + 1, d + 1, .END_SPONSORING_FUTURE_RESERVES => wr_OperationType fu d .END_SPONSORING_FUTURE_RESERVES
  | fu + 1, d + 1, .REVOKE_SPONSORSHIP a => wSeq [wr_OperationType fu d .REVOKE_SPONSORSHIP, wr_RevokeSponsorshipOp fu d a]
  | fu + 1, d + 1, .CLAWBACK a => wSeq [wr_OperationType fu d .CLAWBACK, wr_ClawbackOp fu d a]
  | fu + 1, d + 1, .CLAWBACK_CLAIMABLE_BALANCE a => wSeq [wr_OperationType fu d .CLAWBACK_CLAIMABLE_BALANCE, wr_ClawbackClaimableBalanceOp fu d a]
  | fu + 1, d + 1, .SET_TRUST_LINE_FLAGS a => wSeq [wr_OperationType fu d .SET_TRUST_LINE_FLAGS, wr_SetTrustLineFlagsOp fu d a]
  | fu + 1, d + 1, .LIQUIDITY_POOL_DEPOSIT a => wSeq [wr_OperationType fu d .LIQUIDITY_POOL_DEPOSIT, wr_LiquidityPoolDepositOp fu d a]
  | fu + 1, d + 1, .LIQUIDITY_POOL_WITHDRAW a => wSeq [wr_OperationType fu d .LIQUIDITY_POOL_WITHDRAW, wr_LiquidityPoolWithdrawOp fu d a]
